# Production Environment Configuration Template
# Copy this file to .env.production and fill in your actual production values
# NEVER commit .env.production to version control

# Database - Production PostgreSQL URL (e.g., from Neon, Supabase, AWS RDS)
DATABASE_URL=postgresql://username:password@your-production-db-host:5432/skinlabs_prod

# Authentication (Clerk) - Production keys from your Clerk dashboard
CLERK_SECRET_KEY=sk_live_your_production_clerk_secret_key
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_production_clerk_publishable_key

# PayPal - Production credentials from PayPal Developer Console
PAYPAL_CLIENT_ID=your_production_paypal_client_id
PAYPAL_CLIENT_SECRET=your_production_paypal_client_secret

# Email (SendGrid) - Production API key from SendGrid
SENDGRID_API_KEY=SG.your_production_sendgrid_api_key
SENDGRID_FROM_EMAIL=hello@skinlabs.co.za

# AI Services - Production OpenAI API key
OPENAI_API_KEY=sk-your_production_openai_api_key

# API Keys - Secure random API key for content automation
CONTENT_API_KEY=your_secure_production_api_key_at_least_32_characters

# Analytics - Google Analytics tracking ID
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Monitoring - Sentry DSN for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# File Storage - Cloudinary URL or AWS S3 credentials
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Security - CRITICAL: Generate secure random strings (use openssl rand -hex 32)
JWT_SECRET=your_super_secure_jwt_secret_at_least_64_characters_long_random_string
ENCRYPTION_KEY=your_super_secure_encryption_key_exactly_32_characters_long_hex

# Production settings
NODE_ENV=production
PORT=5000

# Additional production environment variables
DOMAIN=skinlabs.co.za
HTTPS=true
TRUST_PROXY=true