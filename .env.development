# Development Environment Configuration
# This file contains safe defaults for development only
# DO NOT use these values in production

# Database - use a local PostgreSQL instance or neon.tech for development
DATABASE_URL=postgresql://skinlabs:dev_password@localhost:5432/skinlabs_dev

# Authentication (Clerk) - Get these from your Clerk dashboard
CLERK_SECRET_KEY=sk_test_your_development_clerk_secret_key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_development_clerk_publishable_key

# PayPal - Use sandbox credentials for development
PAYPAL_CLIENT_ID=sb_your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=sb_your_paypal_sandbox_client_secret

# Email (SendGrid) - Use a test API key for development
SENDGRID_API_KEY=SG.development_sendgrid_api_key
SENDGRID_FROM_EMAIL=dev@skinlabs.local

# AI Services - Use your OpenAI API key (be careful with usage)
OPENAI_API_KEY=sk-dev_your_openai_api_key

# API Keys - Development secure key
CONTENT_API_KEY=dev_secure_api_key_change_in_production

# Analytics (Optional in development)
VITE_GA_TRACKING_ID=

# Monitoring (Optional in development)
SENTRY_DSN=

# File Storage (Optional in development)
CLOUDINARY_URL=

# Security - Generate secure random strings for development
JWT_SECRET=dev_super_secret_jwt_key_at_least_32_characters_long
ENCRYPTION_KEY=dev_super_secret_encryption_key_32_chars

# Development settings
NODE_ENV=development
PORT=5000